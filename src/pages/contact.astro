---
import Layout from "../layouts/Layout.astro";
import "../styles/contact.css";
---

<Layout title="Prodbytes - Free assets for your next project.">
  <section class="hero">
    <div class="hero-overlay">
      <div class="hero-content">
        <h2 class="hero-title">
          Get in touch.
        </h2>
      </div>
    </div>
  </section>

  <div class="contact-section">
    <div class="site-header">
      <p>
      Have a question, found a bug, or just want to share what you made with
      one of these? <a class="contact-email" href="mailto:hello@timdwyer.co">hello@timdwyer.co</a>
    </p>
    </div>
  </div>
</Layout>