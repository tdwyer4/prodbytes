---
import "../styles/global.css";
---

<footer class="global-footer">
  <div class="footer-left">
    <div class="footer-brand">
      <a href="/" class="brand-link">
        <img
          src="/Prodbytes_WEB.png"
          alt="Prodbytes Logo"
          class="brand-logo"
          width="26"
          height="26"
        />
      </a>
      <span class="brand-name">Prodbytes</span>
    </div>
    <div class="footer-author">
      <span class="author"
        >Made with ♥ by <a href="https://timdwyer.co">Tim Dwyer</a></span
      >
    </div>
  </div>

  <div class="footer-right">
    <div class="footer-links">
      <span class="footer-links-item"><a href="/about">About</a></span>
      <span class="footer-links-item"><a href="/contact">Contact</a></span>
      <span class="footer-links-item"><a href="/privacy">Privacy</a></span>
    </div>
    <div class="legal">
      <span class="copyright">© 2026 Prodbytes</span>
      <!-- <span>|</span>
      <span class="privacy"><a href="/privacy">Privacy Policy</a></span> -->
    </div>
  </div>
</footer>
